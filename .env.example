# Server
PORT=8080

# Database Connection (Constructs JDBC URL: jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME})
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ledgerline
DB_PARAMS=

# Database Credentials
# Owner account for Flyway migrations (runs as ledger_owner)
POSTGRES_USER=ledger_owner
POSTGRES_PASSWORD=replace_with_strong_owner_password
DB_USER=ledger_owner
DB_PASSWORD=replace_with_strong_owner_password
DB_MIGRATION_USER=ledger_owner
DB_MIGRATION_PASSWORD=replace_with_strong_owner_password

# Restricted runtime application role
APP_DB_USER=ledger_app
APP_DB_PASSWORD=replace_with_strong_app_password

# Cryptographic Authentication Secret (Minimum 32 bytes / 256 bits)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_of_at_least_32_bytes!

# Idempotent Initial User Seeding Passwords
SEED_ADMIN_PASSWORD=replace_with_secure_admin_password
SEED_HOLDER_PASSWORD=replace_with_secure_holder_password
SEED_AUDITOR_PASSWORD=replace_with_secure_auditor_password

